  "questionnaire_template": {
    "steps": [
      {
        "step": 1,
        "id": "qualification_selection",
        "title": "Select Qualification",
        "title_ar": "اختر المؤهل",
        "title_hi": "योग्यता चुनें",
        "subtitle": "Choose your qualification type",
        "fields": [
          {
            "id": "qualification_id",
            "type": "radio_cards",
            "label": "Qualification Type",
            "required": true,
            "options_from": "profession.qualifications"
          }
        ]
      },
      {
        "step": 2,
        "id": "academic_status",
        "title": "Academic Status",
        "title_ar": "الحالة الأكاديمية",
        "title_hi": "शैक्षणिक स्थिति",
        "subtitle": "Tell us about your current academic status",
        "fields": [
          {
            "id": "degree_status",
            "type": "radio",
            "label": "Current Status",
            "required": true,
            "options": [
              {"value": "ongoing", "label": "Degree Ongoing", "label_ar": "الدراسة مستمرة", "label_hi": "डिग्री जारी"},
              {"value": "completed", "label": "Degree Completed", "label_ar": "الدراسة مكتملة", "label_hi": "डिग्री पूर्ण"}
            ]
          }
        ]
      },
      {
        "step": 3,
        "id": "degree_ongoing_details",
        "title": "Current Academic Year",
        "title_ar": "السنة الأكاديمية الحالية",
        "title_hi": "वर्तमान शैक्षणिक वर्ष",
        "condition": {"field": "degree_status", "value": "ongoing"},
        "fields": [
          {
            "id": "current_year",
            "type": "radio",
            "label": "Select your current year",
            "required": true,
            "options_from": "qualification.academic_years"
          },
          {
            "id": "university_id",
            "type": "searchable_dropdown",
            "label": "University of Education",
            "required": true,
            "options_endpoint": "/api/universities",
            "placeholder": "Search for your university"
          }
        ]
      },
      {
        "step": 4,
        "id": "pg_status",
        "title": "Post Graduation Status",
        "title_ar": "حالة الدراسات العليا",
        "title_hi": "स्नातकोत्तर स्थिति",
        "condition": {
          "all": [
            {"field": "degree_status", "value": "completed"},
            {"field": "qualification.has_pg", "value": true}
          ]
        },
        "fields": [
          {
            "id": "is_pg_holder",
            "type": "radio",
            "label": "Are you a PG Holder?",
            "required": true,
            "options": [
              {"value": "yes", "label": "PG-Holder"},
              {"value": "no", "label": "Not-PG-Holder"}
            ]
          }
        ]
      },
      {
        "step": 5,
        "id": "specialization",
        "title": "Specialization",
        "title_ar": "التخصص",
        "title_hi": "विशेषज्ञता",
        "condition": {"field": "is_pg_holder", "value": "yes"},
        "fields": [
          {
            "id": "specialization_id",
            "type": "grid_selection",
            "label": "Select your specialization",
            "required": true,
            "options_from": "profession.specializations",
            "columns": 2
          },
          {
            "id": "specialization_other",
            "type": "text",
            "label": "Please specify",
            "required": true,
            "condition": {"field": "specialization_id", "value": "others"},
            "validation": {
              "min_length": 3,
              "max_length": 100
            }
          }
        ]
      },
      {
        "step": 6,
        "id": "phd_status",
        "title": "PhD Status",
        "title_ar": "حالة الدكتوراه",
        "title_hi": "पीएचडी स्थिति",
        "condition": {
          "all": [
            {"field": "is_pg_holder", "value": "yes"},
            {"field": "qualification.has_phd", "value": true}
          ]
        },
        "fields": [
          {
            "id": "is_phd_holder",
            "type": "radio",
            "label": "PhD Holder Status",
            "required": true,
            "options": [
              {"value": "yes", "label": "Yes"},
              {"value": "no", "label": "No"},
              {"value": "ongoing", "label": "Ongoing"}
            ]
          }
        ]
      },
      {
        "step": 7,
        "id": "internship_status",
        "title": "Internship Status",
        "title_ar": "حالة التدريب",
        "title_hi": "इंटर्नशिप स्थिति",
        "condition": {
          "all": [
            {"field": "degree_status", "value": "completed"},
            {"field": "qualification.has_internship", "value": true}
          ]
        },
        "fields": [
          {
            "id": "internship_completed",
            "type": "radio",
            "label": "Have you completed your internship?",
            "required": true,
            "options": [
              {"value": "yes", "label": "Yes"},
              {"value": "no", "label": "No"}
            ]
          }
        ]
      },
      {
        "step": 8,
        "id": "work_experience",
        "title": "Work Experience",
        "title_ar": "الخبرة العملية",
        "title_hi": "कार्य अनुभव",
        "condition": {"field": "degree_status", "value": "completed"},
        "fields": [
          {
            "id": "has_work_experience",
            "type": "radio",
            "label": "Do you have work experience?",
            "required": true,
            "options": [
              {"value": "yes", "label": "Yes"},
              {"value": "no", "label": "No"}
            ]
          }
        ]
      },
      {
        "step": 9,
        "id": "experience_details",
        "title": "Experience Details",
        "title_ar": "تفاصيل الخبرة",
        "title_hi": "अनुभव विवरण",
        "condition": {"field": "has_work_experience", "value": "yes"},
        "repeatable": true,
        "max_entries": 10,
        "add_button_label": "Add Another Experience",
        "fields": [
          {
            "id": "experience_type",
            "type": "radio",
            "label": "Type of Experience",
            "required": true,
            "options": [
              {"value": "clinical", "label": "Clinical"},
              {"value": "non_clinical", "label": "Non Clinical"}
            ]
          },
          {
            "id": "organisation_name",
            "type": "text",
            "label": "Organisation/Hospital Name",
            "required": true,
            "placeholder": "Enter organisation name",
            "validation": {
              "min_length": 3,
              "max_length": 200,
              "pattern": "^[a-zA-Z0-9\\s\\-\\.,'()&]+$"
            }
          },
          {
            "id": "work_specialization_id",
            "type": "dropdown",
            "label": "Work Specialization",
            "required": false,
            "options_from": "profession.specializations",
            "condition": {"field": "profession.specializations.length", "operator": ">", "value": 0}
          },
          {
            "id": "from_date",
            "type": "date",
            "label": "From Date",
            "required": true,
            "format": "yyyy-MM-dd",
            "min_year": 1965,
            "max_date": "today"
          },
          {
            "id": "to_date",
            "type": "date",
            "label": "To Date",
            "required": true,
            "format": "yyyy-MM-dd",
            "min_year": 1965,
            "max_date": "today",
            "allow_present": true,
            "present_label": "Currently Working"
          }
        ]
      },
      {
        "step": 10,
        "id": "country_preference",
        "title": "Country Preferences",
        "title_ar": "تفضيلات البلد",
        "title_hi": "देश की प्राथमिकताएं",
        "subtitle": "Select countries where you'd like to work",
        "fields": [
          {
            "id": "preferred_countries",
            "type": "multi_select_chips",
            "label": "Select preferred countries",
            "required": true,
            "min_selections": 1,
            "max_selections": 10,
            "options_endpoint": "/api/countries"
          }
        ]
      },
      {
        "step": 11,
        "id": "documents",
        "title": "Upload Documents",
        "title_ar": "تحميل المستندات",
        "title_hi": "दस्तावेज़ अपलोड करें",
        "subtitle": "Upload your certificates and documents",
        "optional": true,
        "fields": [
          {
            "id": "degree_certificate",
            "type": "file_upload",
            "label": "Degree Certificate",
            "required": false,
            "accepted_formats": ["pdf", "jpg", "jpeg", "png"],
            "max_size_mb": 5
          },
          {
            "id": "experience_certificate",
            "type": "file_upload",
            "label": "Experience Certificate",
            "required": false,
            "accepted_formats": ["pdf", "jpg", "jpeg", "png"],
            "max_size_mb": 5,
            "condition": {"field": "has_work_experience", "value": "yes"}
          },
          {
            "id": "specialization_certificate",
            "type": "file_upload",
            "label": "Specialization Certificate",
            "required": false,
            "accepted_formats": ["pdf", "doc", "docx"],
            "max_size_mb": 10,
            "condition": {"field": "is_pg_holder", "value": "yes"}
          }
        ]
      }
    ]
  },
  "field_types": {
    "radio": {
      "description": "Single selection from options",
      "flutter_widget": "RadioListTile"
    },
    "radio_cards": {
      "description": "Card-style single selection",
      "flutter_widget": "Custom RadioCard"
    },
    "dropdown": {
      "description": "Dropdown select",
      "flutter_widget": "DropdownButtonFormField"
    },
    "searchable_dropdown": {
      "description": "Searchable/filterable dropdown",
      "flutter_widget": "Custom SearchableDropdown"
    },
    "grid_selection": {
      "description": "Grid of selectable options",
      "flutter_widget": "Custom GridSelection"
    },
    "multi_select_chips": {
      "description": "Multiple selection with chips",
      "flutter_widget": "Wrap with FilterChip"
    },
    "text": {
      "description": "Text input field",
      "flutter_widget": "TextFormField"
    },
    "date": {
      "description": "Date picker",
      "flutter_widget": "showDatePicker"
    },
    "file_upload": {
      "description": "File upload",
      "flutter_widget": "Custom FileUploader"
    }
  }
}
